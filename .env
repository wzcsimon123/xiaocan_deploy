# ========== 一键部署配置 ==========
# 镜像标签（与 Docker Hub 上一致）
IMAGE_TAG=latest

# 对外访问端口
HTTP_PORT=80

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DB=xiaocan
MYSQL_USER=xiaocan
MYSQL_PASSWORD=xiaocan123

# Redis（留空=无密码）
REDIS_PASSWORD=

# 公网前端地址（末尾不要 /），用于 wxpusher iframe 推送
# 例: http://192.168.1.100  或  https://xiaocan.example.com
SYSTEM_WEB_URL=

# JVM
JAVA_OPTS=-Xmx256m -Xms128m
